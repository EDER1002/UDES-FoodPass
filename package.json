{
  "name": "udes-foodpass",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web para reservar y reclamar almuerzos con ficho digital QR en la cafetería de la UDES.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:levantar": "docker compose up -d",
    "db:apagar": "docker compose down",
    "db:migrar": "npm run db:migrar -w backend",
    "db:seed": "npm run db:seed -w backend",
    "pago:webhook": "npm run pago:webhook -w backend --",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:celular": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev:celular -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "prueba:navegador": "playwright test -c e2e",
    "diseno:capturas": "CAPTURAS=1 playwright test -c e2e capturas"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.56.1",
    "concurrently": "^10.0.6"
  }
}
