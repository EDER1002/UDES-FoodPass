# =====================================================================
# UDES FoodPass — variables de entorno
#
# Cómo usarlo: copia este archivo con el nombre ".env" (en la raíz del
# proyecto) y cambia los valores marcados con "cambia_esto".
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# =====================================================================

# --- Base de datos (PostgreSQL) -------------------------------------
# docker-compose.yml usa estas tres para crear la base de datos.
POSTGRES_USER=foodpass
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=udes_foodpass
# Puerto de tu computador donde quedará PostgreSQL (cámbialo si 5432 está ocupado).
POSTGRES_PORT=5432

# Cadena de conexión que usa el backend (debe coincidir con lo de arriba).
DATABASE_URL=postgres://foodpass:cambia_esto@localhost:5432/udes_foodpass
# Base de datos aparte para las pruebas automáticas (se borra y se recrea).
DATABASE_URL_TEST=postgres://foodpass:cambia_esto@localhost:5432/udes_foodpass_test

# --- Backend (API REST) ---------------------------------------------
PORT=3000
NODE_ENV=development
# Zona horaria de las reglas de negocio (horarios de reserva).
ZONA_HORARIA=America/Bogota
# Secreto para firmar los JWT: una cadena larga y aleatoria.
JWT_SECRETO=cambia_esto_por_una_cadena_larga_y_aleatoria
# Duración de la sesión (formato de la librería jsonwebtoken: 8h, 30m...).
JWT_EXPIRACION=8h
# Costo de bcrypt para cifrar contraseñas (10–12 es razonable).
BCRYPT_RONDAS=10
# Única dirección desde la que el navegador puede llamar a la API (CORS).
CORS_ORIGEN=http://localhost:5173

# --- Pagos (entorno de pruebas, sin dinero real) --------------------
# "sandbox" usa el adaptador simulado. Aún no hay pasarela real (Wompi o ePayco).
PASARELA_MODO=sandbox
# Secreto compartido para verificar la firma de POST /api/pagos/webhook.
WEBHOOK_SECRETO=cambia_esto_por_otra_cadena_aleatoria

# --- Frontend (Vite) ------------------------------------------------
# El frontend NO lee este archivo. Llama a la API en "/api" y Vite la
# reenvía al backend. Para usar otra dirección, crea frontend/.env con:
#   VITE_API_URL=https://mi-servidor/api
